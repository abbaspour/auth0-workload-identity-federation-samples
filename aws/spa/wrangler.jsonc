{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only: the Worker serves the Vite build and has no script of its own.
  "name": "auth0-wif-aws-spa",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Serve only from the custom domain. This host must equal `spa_domain` in aws/tf (Auth0 URLs and S3 CORS).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aws.wif.abbaspour.net",
      "custom_domain": true
    }
  ]
}
